{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mira",
  "version": "0.1.0",
  "identifier": "com.cosmoartsstore.mira",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mira",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:1421 ws://localhost:1421 https://fonts.googleapis.com https://fonts.gstatic.com;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$PICTURE/VRChat/**/*.png",
          "$PICTURE/VRChat/**/*.jpg",
          "$PICTURE/VRChat/**/*.jpeg"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": ["icons/128x128.png", "icons/icon.png"],
    "publisher": "CosmoArtsStore",
    "copyright": "Copyright (c) 2025-2026 CosmoArtsStore. All rights reserved.",
    "shortDescription": "VRChat 滞在をふり返るデスクトップアプリ",
    "longDescription": "Mira は VRChat の出来事ログ・写真・メモを横断して、毎日の VRChat 体験をふり返るためのローカル専用デスクトップアプリです。",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "template": "windows/installer.nsi",
        "installerHooks": "windows/hooks.nsi",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["Japanese"],
        "displayLanguageSelector": false
      }
    }
  }
}
